# Memo Application - Environment Configuration Example
# Copy this file to .env and fill in your specific values
# WARNING: Never commit .env to version control - add it to .gitignore

# Database Configuration
MEMO_DB_PATH=${HOME}/.memo/memos.db
MEMO_BACKUP_DIR=${HOME}/.memo/backups

# Logging Configuration
MEMO_LOG_DIR=${HOME}/.memo/logs
MEMO_LOG_LEVEL=INFO

# Limits and Timeouts
MEMO_MAX_MEMO_SIZE=16384
MEMO_LOCK_TIMEOUT=10.0
MEMO_LOCK_RETRY_INTERVAL=0.1

# Behavior Settings
MEMO_AUTO_TAG=true
MEMO_AUTO_ARCHIVE=false
MEMO_DATE_FORMAT=%Y-%m-%d %H:%M

# Cloud Sync Configuration (optional)
MEMO_SYNC_ENABLED=false
MEMO_SYNC_INTERVAL=300
MEMO_SYNC_TARGET=local
# For WebDAV sync:
# MEMO_WEBDAV_URL=https://nextcloud.example.com/remote.php/webdav/
# MEMO_WEBDAV_USERNAME=username
# MEMO_WEBDAV_PASSWORD=password

# Editor Configuration
MEMO_EDITOR=nano

# Performance Tuning
MEMO_CACHE_ENABLED=true
MEMO_CACHE_TTL=300
MEMO_MAX_CACHE_ITEMS=1000

# Security (if encryption is enabled)
# MEMO_ENCRYPTION_ENABLED=false
# MEMO_ENCRYPTION_PASSWORD=your-secure-password

# API Server (if running as service)
MEMO_API_HOST=127.0.0.1
MEMO_API_PORT=8000
MEMO_API_DEBUG=false

# Backup Configuration
MEMO_BACKUP_ENABLED=true
MEMO_BACKUP_INTERVAL=3600
MEMO_BACKUP_RETENTION_DAYS=30

# Search Configuration
MEMO_FTS_MIN_TERM_LENGTH=2
MEMO_FTS_MAX_PHRASE_LENGTH=5
